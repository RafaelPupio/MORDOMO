# Neon Postgres (pooled connection string)
DATABASE_URL=
# Vercel AI Gateway key (Vercel dashboard → AI Gateway)
AI_GATEWAY_API_KEY=
# Global monthly demo cap in USD (all tenants combined)
DEMO_GLOBAL_MONTHLY_USD_CAP=50
# Staff area (POST /staff/login). Fails closed when unset — nobody can sign in.
STAFF_PASSWORD=
# Secret used to sign the staff session cookie. Generate: openssl rand -hex 32
STAFF_SESSION_SECRET=
