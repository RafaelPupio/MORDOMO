# Neon Postgres (pooled connection string)
DATABASE_URL=
# Vercel AI Gateway key (Vercel dashboard → AI Gateway)
AI_GATEWAY_API_KEY=
# Global monthly demo cap in USD (all tenants combined)
DEMO_GLOBAL_MONTHLY_USD_CAP=50
# Staff area (POST /staff/login). Fails closed when unset — nobody can sign in.
STAFF_PASSWORD=
# Secret used to sign the staff session cookie. Generate: openssl rand -hex 32
STAFF_SESSION_SECRET=
# Shared secret for GET /api/cron/weekly-report. Vercel sets this automatically for cron
# invocations once the project has a CRON_SECRET env var — you do not send it yourself.
# Fails closed when unset: an empty value means the endpoint refuses every caller, not
# that it admits everyone. Generate: openssl rand -hex 32
CRON_SECRET=
